<file path="src/styles/global.css">
@import "tailwindcss";

@theme {
  --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

  --color-canvas: #FAF9F5;
  --color-surface: #EBE9E2;
  --color-ink: #1E232A;
  --color-slate: #2C333D;
  --color-muted: #4B5563;
}

@layer base {
  body {
    font-family: var(--font-sans);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    -webkit-font-smoothing: antialiased;
  }
}

@layer components {
  .section-shell {
    @apply w-full scroll-mt-24 bg-canvas text-ink;
  }

  .section-container {
    @apply mx-auto w-full max-w-360 px-6 md:px-12;
  }

  .section-divider {
    @apply border-b border-ink/15 pb-4;
  }

  .text-display {
    @apply text-4xl leading-[1.06] font-semibold tracking-[-0.03em] text-ink uppercase sm:text-5xl md:text-6xl lg:text-[4.25rem];
  }

  .text-brand {
    @apply text-xl leading-[1.2] font-semibold tracking-[-0.02em] text-ink sm:text-2xl;
  }

  .text-section-label {
    @apply text-sm leading-[1.4] font-medium tracking-widest text-slate-500 uppercase;
  }

  .text-heading {
    @apply text-3xl leading-[1.2] font-medium tracking-tight text-ink sm:text-4xl;
  }

  .text-card-title {
    @apply text-xl leading-tight font-medium tracking-[-0.02em] text-ink sm:text-2xl;
  }

  .text-body {
    @apply text-sm leading-[1.65] font-normal tracking-[-0.01em] text-gray-600 sm:text-[15px];
  }

  .text-body-strong {
    @apply text-sm leading-normal font-medium tracking-[-0.01em] text-ink sm:text-[15px];
  }

  .text-meta {
    @apply text-xs leading-[1.4] font-medium tracking-[0.02em] text-gray-600;
  }

  .text-ui-label {
    @apply text-xs leading-[1.4] font-semibold tracking-[0.06em] text-gray-600 uppercase;
  }

  .card-frame {
    @apply overflow-hidden rounded-3xl border border-ink/8 bg-surface shadow-none;
  }

  .btn-primary {
    @apply inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-ink/10 bg-slate px-10 py-4 text-xs leading-none font-medium tracking-[0.06em] text-white uppercase shadow-none transition-colors duration-200 hover:bg-ink active:scale-98 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink disabled:cursor-not-allowed disabled:opacity-60;
  }

  .btn-icon-circle {
    @apply flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-ink bg-transparent text-ink shadow-none transition-colors duration-200 hover:bg-ink hover:text-canvas active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink;
  }

  .form-input {
    @apply w-full scroll-mt-28 border-b border-gray-600 bg-transparent pt-1 pb-3.5 text-base leading-normal font-normal tracking-[-0.01em] text-ink transition-colors placeholder:text-gray-600 focus:border-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink sm:text-lg;
  }
}
