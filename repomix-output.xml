    {
      title: "Oaxacan Terracotta Residence",
      architect: "Mateo Morales (2023 - 2025)",
      location: "San Felipe del Agua | Oaxaca, Mexico",
      size: "5,900 sq ft arranged around three open-air peristyle courtyards and a shaded botanical terrace",
      aesthetics:
        "Hand-pressed local clay brick, pigmented lime plaster walls, and tropical parota hardwood pergolas filtering southern sunlight",
      image: {
        src: "/images/project-05-oaxaca.jpg",
        alt: "Mexican courtyard residence in warm terracotta brick and earth plaster with timber pergola shadows and agave garden",
      },
    },
    {
