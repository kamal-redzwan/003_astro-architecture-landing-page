                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3.5 10.6569C3.5 9.7534 3.5 9.30166 3.71352 8.90569C3.92705 8.50973 4.30292 8.25915 5.05466 7.75799L9.55466 4.75799C10.9434 3.83214 11.6378 3.36922 12.4399 3.36922C13.242 3.36922 13.9364 3.83214 15.3251 4.75799L19.8251 7.75799C20.5769 8.25915 20.9527 8.50973 21.1663 8.90569C21.3798 9.30166 21.3798 9.7534 21.3798 10.6569V16C21.3798 17.8856 21.3798 18.8284 20.794 19.4142C20.2082 20 19.2654 20 17.3798 20H7.5C5.61438 20 4.67157 20 4.08579 19.4142C3.5 18.8284 3.5 17.8856 3.5 16V10.6569Z" />
                    <path d="M12.44 16.2C12.44 16.2 9.2 14.15 9.2 11.95C9.2 10.85 10.05 10 11.05 10C11.68 10 12.18 10.35 12.44 10.82C12.7 10.35 13.2 10 13.83 10C14.83 10 15.68 10.85 15.68 11.95C15.68 14.15 12.44 16.2 12.44 16.2Z" />
