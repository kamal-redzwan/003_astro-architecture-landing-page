}

const {
  sectionLabel = "About Us",
  paragraph = "Rooted in tactile honesty and spatial harmony, we weave raw stone, warm timber, and sculpted daylight into enduring sanctuaries that quiet the mind and ground everyday living.",
  image = {
    src: "/images/about-courtyard.jpg",
    alt: "Open-air travertine and concrete architectural courtyard with a timber skylight oculus and reflecting pool",
