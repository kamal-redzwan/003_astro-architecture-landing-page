            loading="lazy"
          />

          <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-ink/85 via-ink/25 to-transparent"></div>

          <div
            class="border-white/25 bg-ink/45 absolute top-6 left-6 flex h-11 w-11 items-center justify-center rounded-2xl border text-white backdrop-blur-md"
            aria-hidden="true"
          >
            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="none"
