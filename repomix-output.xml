        src: "/images/project-03-sonoma.jpg",
        alt: "California vineyard residence with rammed earth walls, cantilevered Corten steel roof, and stone courtyard with olive trees",
      },
    },
    {
      title: "Alpine Timber Atelier",
      architect: "Lukas Vonlanthen (2021 - 2023)",
      location: "Engadin Valley | Graubünden, Switzerland",
      size: "5,150 sq ft featuring double-height design studio, library mezzanine, and private living quarters",
      aesthetics:
        "Untreated larch vertical siding, bush-hammered concrete core, and deep-set timber window frames engineered for alpine snow loads",
