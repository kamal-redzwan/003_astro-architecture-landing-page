---
export interface SocialLink {
  label: string;
  href: string;
  icon: "instagram" | "linkedin" | "x";
}

export interface LegalLink {
  label: string;
  href: string;
}

interface Props {
  brandName?: string;
  copyrightText?: string;
  legalLinks?: LegalLink[];
  socials?: SocialLink[];
}

const {
  brandName = "Aetherion",
  copyrightText = "©2026 AETHERION STUDIO. All Rights Reserved",
  legalLinks = [
    { label: "Privacy Policy", href: "/privacy" },
    { label: "Terms of Service", href: "/terms" },
  ],
  socials = [
    {
      label: "Instagram",
      href: "https://instagram.com",
      icon: "instagram",
    },
    {
      label: "LinkedIn",
      href: "https://linkedin.com",
      icon: "linkedin",
    },
    {
      label: "X",
      href: "https://x.com",
      icon: "x",
    },
  ],
} = Astro.props;
---

<footer class="bg-canvas text-ink w-full pb-12 md:pb-16">
  <div class="section-container">
    <div class="section-divider"></div>

    <div class="mt-8 grid grid-cols-1 items-center gap-6 md:mt-10 md:grid-cols-3">
      <div class="flex items-center md:justify-self-start">
        <a
          href="/"
          class="text-brand focus-visible:outline-ink inline-block transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          {brandName}
        </a>
      </div>

      <div class="flex flex-col items-start gap-2 md:items-center md:justify-self-center md:text-center">
        <p class="text-meta text-gray-600">{copyrightText}</p>

        {legalLinks.length > 0 && (
          <nav aria-label="Legal">
            <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 md:justify-center">
              {legalLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-meta hover:text-ink focus-visible:outline-ink inline-block text-gray-600 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>

      <ul
        class="flex items-center gap-3 md:justify-self-end"
        aria-label="Social media"
      >
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="border-muted text-ink hover:border-ink hover:bg-ink hover:text-canvas focus-visible:outline-ink flex h-11 w-11 items-center justify-center rounded-full border transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              {social.icon === "instagram" && (
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              )}
              {social.icon === "linkedin" && (
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect width="4" height="12" x="2" y="9"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              )}
              {social.icon === "x" && (
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
                  <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
