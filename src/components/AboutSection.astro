---
interface FeatureItem {
  label: string;
  icon: "natural-materials" | "meaningful-living";
}

interface Props {
  sectionLabel?: string;
  paragraph?: string;
  image?: {
    src: string;
    alt: string;
    caption?: string;
  };
  features?: FeatureItem[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  sectionLabel = "About Us",
  paragraph = "Rooted in tactile honesty and spatial harmony, we weave raw stone, warm timber, and sculpted daylight into enduring sanctuaries that quiet the mind and ground everyday living.",
  image = {
    src: "/images/about-courtyard.jpg",
    alt: "Open-air travertine and concrete architectural courtyard with a timber skylight oculus and reflecting pool",
    caption:
      "Sculpting Light & Matter: Every threshold is choreographed to blur the boundary between built form and living landscape.",
  },
  features = [
    { label: "Crafted with Natural Materials", icon: "natural-materials" },
    { label: "Designed for Meaningful Living", icon: "meaningful-living" },
  ],
} = Astro.props;

const words = paragraph.split(" ");
---

<section id="about" aria-labelledby="about-heading" class="section-shell">
  <div class="section-container">
    <div class="section-divider">
      <h2
        id="about-heading"
        class="text-section-label text-sm uppercase tracking-widest text-slate-500"
      >
        {sectionLabel}
      </h2>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-10 md:mt-10 lg:grid-cols-12 lg:items-start lg:gap-12">
      <div class="flex flex-col justify-between gap-8 lg:col-span-5">
        <p id="about-scroll-text" class="text-heading text-3xl sm:text-4xl">
          {words.map((word, index) => (
            <>
              <span
                data-scroll-word
                data-index={index}
                class="text-gray-600 transition-colors duration-200 ease-out"
              >
                {word}
              </span>{" "}
            </>
          ))}
        </p>

        <div class="flex flex-col gap-4 border-t border-ink/15 pt-6 sm:flex-row sm:flex-wrap lg:flex-col">
          {features.map((feature) => (
            <div class="flex items-center gap-3.5">
              <div class="bg-surface text-ink flex h-12 w-12 shrink-0 items-center justify-center rounded-xl">
                {feature.icon === "natural-materials" ? (
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.65"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20.24 3.76C19.72 3.24 12.66 2.5 7.58 7.58C3.52 11.64 3.82 16.59 4.5 18.5C6.41 19.18 11.36 19.48 15.42 15.42C20.5 10.34 19.76 3.28 20.24 3.76Z" />
                    <path d="M3.5 20.5C6.5 17.5 10.5 13.5 15.5 9.5" />
                    <path d="M9.5 14.3L9.2 10.5" />
                    <path d="M13.5 11.2L10.8 11.5" />
                  </svg>
                ) : (
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.65"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3.5 10.6569C3.5 9.7534 3.5 9.30166 3.71352 8.90569C3.92705 8.50973 4.30292 8.25915 5.05466 7.75799L9.55466 4.75799C10.9434 3.83214 11.6378 3.36922 12.4399 3.36922C13.242 3.36922 13.9364 3.83214 15.3251 4.75799L19.8251 7.75799C20.5769 8.25915 20.9527 8.50973 21.1663 8.90569C21.3798 9.30166 21.3798 9.7534 21.3798 10.6569V16C21.3798 17.8856 21.3798 18.8284 20.794 19.4142C20.2082 20 19.2654 20 17.3798 20H7.5C5.61438 20 4.67157 20 4.08579 19.4142C3.5 18.8284 3.5 17.8856 3.5 16V10.6569Z" />
                    <path d="M12.44 16.2C12.44 16.2 9.2 14.15 9.2 11.95C9.2 10.85 10.05 10 11.05 10C11.68 10 12.18 10.35 12.44 10.82C12.7 10.35 13.2 10 13.83 10C14.83 10 15.68 10.85 15.68 11.95C15.68 14.15 12.44 16.2 12.44 16.2Z" />
                  </svg>
                )}
              </div>
              <span class="text-body-strong">{feature.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="card-frame group relative">
          <img
            src={image.src}
            alt={image.alt}
            class="h-85 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] sm:h-105 md:h-115"
            loading="lazy"
          />

          <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-ink/85 via-ink/25 to-transparent"></div>

          <div
            class="border-white/25 bg-ink/45 absolute top-6 left-6 flex h-11 w-11 items-center justify-center rounded-2xl border text-white backdrop-blur-md"
            aria-hidden="true"
          >
            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.65"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 3L20 7.5V16.5L12 21L4 16.5V7.5L12 3Z"></path>
              <path d="M12 12L20 7.5"></path>
              <path d="M12 12V21"></path>
              <path d="M12 12L4 7.5"></path>
              <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
            </svg>
          </div>

          <div class="absolute bottom-6 left-6 max-w-md pr-6">
            <p class="text-body text-white">
              Sculpting Light &amp; Matter: Every threshold is choreographed to
              blur the boundary between built form and living landscape.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const textContainer = document.getElementById("about-scroll-text");
  const wordElements =
    document.querySelectorAll<HTMLElement>("[data-scroll-word]");

  const updateScrollReveal = () => {
    if (!textContainer || wordElements.length === 0) return;

    const rect = textContainer.getBoundingClientRect();
    const viewportHeight = window.innerHeight;

    const start = viewportHeight * 0.85;
    const end = viewportHeight * 0.3;

    const rawProgress = (start - rect.top) / (start - end);
    const progress = Math.max(0, Math.min(1, rawProgress));

    const totalWords = wordElements.length;
    const activeWordCount = Math.floor(progress * totalWords);

    wordElements.forEach((wordEl, idx) => {
      if (idx <= activeWordCount && progress > 0) {
        wordEl.classList.remove("text-gray-600");
        wordEl.classList.add("text-ink");
      } else {
        wordEl.classList.remove("text-ink");
        wordEl.classList.add("text-gray-600");
      }
    });
  };

  window.addEventListener("scroll", updateScrollReveal, { passive: true });
  window.addEventListener("resize", updateScrollReveal, { passive: true });
  updateScrollReveal();
</script>
