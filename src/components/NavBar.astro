---
export interface NavItem {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  brandName?: string;
  items?: NavItem[];
}

const isHomePage = Astro.url.pathname === "/";

const {
  brandName = "Aetherion",
  items = [
    { label: "HOME", href: "#home", active: isHomePage },
    { label: "ABOUT", href: "#about" },
    { label: "SERVICES", href: "#services" },
    { label: "PROJECTS", href: "#projects" },
    { label: "CONTACT US", href: "#contact" },
  ],
} = Astro.props;

const resolvedItems = items.map((item) => ({
  ...item,
  href: !isHomePage && item.href.startsWith("#") ? `/${item.href}` : item.href,
}));
---

<header class="fixed top-0 right-0 left-0 z-50 w-full py-4">
  <div
    aria-hidden="true"
    class="from-canvas/90 via-canvas/55 pointer-events-none absolute inset-0 -z-10 bg-linear-to-b to-transparent backdrop-blur-md mask-[linear-gradient(to_bottom,black_0%,black_35%,transparent_100%)]"
  ></div>
  <site-nav class="section-container block">
    <nav
      class="flex w-full items-center justify-between"
      aria-label="Main Navigation"
    >
      <a
        href="/"
        class="text-brand transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      >
        {brandName}
      </a>

      <ul class="relative hidden items-center gap-1 rounded-full border border-ink/10 bg-slate p-1.5 shadow-none md:flex">
        <li
          data-nav-pill
          aria-hidden="true"
          class:list={[
            "bg-canvas pointer-events-none absolute top-1.5 bottom-1.5 left-1.5 z-0 rounded-full shadow-none transition-all duration-300 ease-out",
            !resolvedItems.some((item) => item.active) && "opacity-0",
          ]}
        ></li>
        {resolvedItems.map((item) => (
          <li class="z-10">
            <a
              href={item.href}
              data-nav-link={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "focus-visible:outline-canvas relative z-10 inline-block rounded-full px-6 py-2.5 text-xs leading-none font-medium tracking-[0.06em] uppercase transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2",
                item.active
                  ? "text-ink"
                  : "text-canvas/90 hover:bg-canvas/15 hover:text-canvas",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        data-mobile-toggle
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="text-canvas flex h-11 w-11 items-center justify-center rounded-full border border-ink/10 bg-slate shadow-none transition hover:bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink md:hidden"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            data-icon-open
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.75"
            d="M4 7h16M4 12h16M4 17h16"
          ></path>
          <path
            data-icon-close
            class="hidden"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.75"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </nav>

    <div
      data-mobile-menu
      class="border-canvas/15 mt-3 hidden w-full overflow-hidden rounded-3xl border bg-slate p-2 shadow-none md:hidden"
    >
      <ul class="flex flex-col gap-1">
        {resolvedItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-mobile-nav-link={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "block rounded-2xl px-6 py-2.5 text-xs leading-none font-medium tracking-[0.06em] uppercase transition-colors duration-200",
                item.active
                  ? "bg-canvas text-ink"
                  : "text-canvas/90 hover:bg-canvas/10 hover:text-canvas",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </site-nav>
</header>

<script>
  class SiteNav extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";

      const toggleBtn = this.querySelector<HTMLButtonElement>(
        "[data-mobile-toggle]",
      );
      const mobileMenu = this.querySelector<HTMLElement>("[data-mobile-menu]");
      const openIcon = this.querySelector<SVGElement>("[data-icon-open]");
      const closeIcon = this.querySelector<SVGElement>("[data-icon-close]");
      const activePill = this.querySelector<HTMLElement>("[data-nav-pill]");
      const desktopLinks =
        this.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
      const mobileLinks = this.querySelectorAll<HTMLAnchorElement>(
        "[data-mobile-nav-link]",
      );

      const closeMobileMenu = () => {
        if (!toggleBtn || !mobileMenu) return;
        toggleBtn.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
        openIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      };

      toggleBtn?.addEventListener("click", () => {
        const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
        toggleBtn.setAttribute("aria-expanded", String(!isExpanded));
        mobileMenu?.classList.toggle("hidden");
        openIcon?.classList.toggle("hidden");
        closeIcon?.classList.toggle("hidden");
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          toggleBtn?.getAttribute("aria-expanded") === "true"
        ) {
          closeMobileMenu();
          toggleBtn.focus();
        }
      });

      let currentActiveHref =
        this.querySelector<HTMLAnchorElement>(
          '[data-nav-link][aria-current="page"]',
        )?.getAttribute("data-nav-link") ?? "";
      let isProgrammaticScroll = false;
      let scrollLockTimer: number | undefined;

      const updatePillGeometry = (href: string, animate = true) => {
        if (!activePill) return;
        if (!href) {
          activePill.classList.add("opacity-0");
          return;
        }
        const targetLink = this.querySelector<HTMLAnchorElement>(
          `[data-nav-link="${href}"]`,
        );
        const parentLi = targetLink?.parentElement;
        if (!targetLink || !parentLi) {
          activePill.classList.add("opacity-0");
          return;
        }

        activePill.classList.remove("opacity-0");

        if (!animate) {
          activePill.style.transition = "none";
        }

        activePill.style.left = `${parentLi.offsetLeft}px`;
        activePill.style.width = `${parentLi.offsetWidth}px`;

        if (!animate) {
          activePill.getBoundingClientRect();
          activePill.style.transition = "";
        }
      };

      const setActiveNav = (href: string, animate = true) => {
        currentActiveHref = href;

        desktopLinks.forEach((link) => {
          const isActive =
            Boolean(href) && link.getAttribute("data-nav-link") === href;
          if (isActive) {
            link.setAttribute("aria-current", "page");
            link.classList.add("text-ink");
            link.classList.remove(
              "text-canvas/90",
              "hover:bg-canvas/15",
              "hover:text-canvas",
            );
          } else {
            link.removeAttribute("aria-current");
            link.classList.remove("text-ink");
            link.classList.add(
              "text-canvas/90",
              "hover:bg-canvas/15",
              "hover:text-canvas",
            );
          }
        });

        mobileLinks.forEach((link) => {
          const isActive =
            Boolean(href) && link.getAttribute("data-mobile-nav-link") === href;
          if (isActive) {
            link.setAttribute("aria-current", "page");
            link.classList.add("bg-canvas", "text-ink");
            link.classList.remove(
              "text-canvas/90",
              "hover:bg-canvas/10",
              "hover:text-canvas",
            );
          } else {
            link.removeAttribute("aria-current");
            link.classList.remove("bg-canvas", "text-ink");
            link.classList.add(
              "text-canvas/90",
              "hover:bg-canvas/10",
              "hover:text-canvas",
            );
          }
        });

        updatePillGeometry(href, animate);
      };

      const getTrackedSections = () => {
        const allSections = Array.from(
          document.querySelectorAll<HTMLElement>("main section[id]"),
        );
        return allSections.filter((section) =>
          this.querySelector(`[data-nav-link="#${section.id}"]`),
        );
      };

      const syncNavOnScroll = () => {
        if (isProgrammaticScroll) return;

        const sections = getTrackedSections();
        if (sections.length === 0) return;

        const triggerLine = window.innerHeight * 0.4;
        const nearBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 24;

        let activeSection = sections[0];

        if (nearBottom) {
          activeSection = sections[sections.length - 1];
        } else {
          for (const section of sections) {
            const rect = section.getBoundingClientRect();
            if (rect.top <= triggerLine) {
              activeSection = section;
            }
          }
        }

        const nextHref = `#${activeSection.id}`;
        if (nextHref !== currentActiveHref) {
          setActiveNav(nextHref, true);
        }
      };

      const handleNavClick = (event: MouseEvent, href: string | null) => {
        if (!href || !href.startsWith("#")) return;
        const targetSection = document.querySelector<HTMLElement>(href);

        setActiveNav(href, true);
        closeMobileMenu();

        if (!targetSection) return;

        event.preventDefault();
        isProgrammaticScroll = true;
        window.clearTimeout(scrollLockTimer);

        targetSection.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", href);

        scrollLockTimer = window.setTimeout(() => {
          isProgrammaticScroll = false;
          syncNavOnScroll();
        }, 700);
      };

      desktopLinks.forEach((link) => {
        link.addEventListener("click", (event) =>
          handleNavClick(event, link.getAttribute("data-nav-link")),
        );
      });

      mobileLinks.forEach((link) => {
        link.addEventListener("click", (event) =>
          handleNavClick(event, link.getAttribute("data-mobile-nav-link")),
        );
      });

      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              syncNavOnScroll();
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true },
      );

      window.addEventListener(
        "resize",
        () => {
          updatePillGeometry(currentActiveHref, false);
        },
        { passive: true },
      );

      setActiveNav(currentActiveHref, false);
      syncNavOnScroll();
      document.fonts?.ready.then(() => {
        updatePillGeometry(currentActiveHref, false);
      });
    }
  }

  if (!customElements.get("site-nav")) {
    customElements.define("site-nav", SiteNav);
  }
</script>
