---
export interface Testimonial {
  quote: string;
  author: string;
  role: string;
  project: string;
  location: string;
  year: string;
  image: {
    src: string;
    alt: string;
  };
}

interface Props {
  sectionLabel?: string;
  headline?: string;
  subtitle?: string;
  testimonial?: Testimonial;
  companyPlaceholder?: string;
  projectTypes?: string[];
  budgetRanges?: string[];
  submitLabel?: string;
}

const {
  sectionLabel = "Contact Us",
  headline = "Start a Conversation",
  subtitle = "Tell us where you are now and where you want the work to go.",
  testimonial = {
    quote:
      "Aetherion translated our steep hillside parcel into a home of remarkable stillness. Every morning the light moves across the rammed-earth walls and courtyard water basin exactly as they sketched on day one.",
    author: "Marcus & Claire Vance",
    role: "Private Residential Clients",
    project: "Sonoma Vineyard Sanctuary",
    location: "Healdsburg, CA",
    year: "Completed 2025",
    image: {
      src: "/images/project-03-sonoma.jpg",
      alt: "Rammed earth walls and shaded stone courtyard of the Sonoma Vineyard Sanctuary",
    },
  },
  companyPlaceholder = "Private client, studio, or hospitality group (optional)",
  projectTypes = [
    "Residential Architecture",
    "Cultural & Pavilion Design",
    "Hospitality & Retreat",
    "Atelier & Commercial Workspace",
    "Interior Design & Spatial Planning",
  ],
  budgetRanges = ["$250k - $500k", "$500k - $1.2M", "$1.2M - $3M", "$3M+"],
  submitLabel = "Send Inquiry",
} = Astro.props;
---

<section id="contact" aria-labelledby="contact-heading" class="section-shell">
  <div class="section-container">
    <div class="section-divider flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <span class="text-section-label block text-sm uppercase tracking-widest text-slate-500">
          {sectionLabel}
        </span>
        <h2 id="contact-heading" class="text-heading mt-3 text-3xl sm:text-4xl">
          {headline}
        </h2>
      </div>

      <p class="text-body max-w-md text-gray-600 md:text-right">{subtitle}</p>
    </div>

    <div class="mt-8 grid grid-cols-1 items-start gap-10 md:mt-10 lg:grid-cols-12 lg:gap-12">
      <aside
        aria-label="Client testimonial"
        class="card-frame flex flex-col justify-between p-7 shadow-none sm:p-8 lg:col-span-5"
      >
        <div>
          <div class="flex items-center justify-between gap-4 border-b border-ink/12 pb-5">
            <span class="text-ui-label text-gray-600">Client Perspective</span>
            <span class="text-meta text-gray-600">{testimonial.year}</span>
          </div>

          <blockquote class="mt-6">
            <p class="text-card-title leading-relaxed font-normal text-ink">
              &ldquo;{testimonial.quote}&rdquo;
            </p>
          </blockquote>
        </div>

        <div class="mt-8 border-t border-ink/12 pt-6">
          <div class="flex items-center gap-4">
            <img
              src={testimonial.image.src}
              alt={testimonial.image.alt}
              class="h-14 w-14 shrink-0 rounded-2xl border border-ink/10 object-cover"
              loading="lazy"
            />
            <div>
              <p class="text-body-strong text-ink">{testimonial.author}</p>
              <p class="text-meta mt-0.5 text-gray-600">{testimonial.role}</p>
              <p class="text-meta mt-1 text-gray-600">
                {testimonial.project} &middot; {testimonial.location}
              </p>
            </div>
          </div>
        </div>
      </aside>

      <form
        id="contact-inquiry-form"
        novalidate
        class="flex flex-col gap-7 lg:col-span-7"
      >
        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 sm:gap-6">
          <div class="flex flex-col gap-2">
            <label for="inquiry-name" class="text-ui-label text-gray-600">
              Name
            </label>
            <input
              id="inquiry-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Your name"
              class="form-input"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="inquiry-email" class="text-ui-label text-gray-600">
              Email
            </label>
            <input
              id="inquiry-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="name@example.com"
              class="form-input"
            />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="inquiry-company" class="text-ui-label text-gray-600">
            Company
          </label>
          <input
            id="inquiry-company"
            name="company"
            type="text"
            autocomplete="organization"
            placeholder={companyPlaceholder}
            class="form-input"
          />
        </div>

        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 sm:gap-6">
          <div class="flex flex-col gap-2">
            <label
              for="inquiry-project-type"
              class="text-ui-label text-gray-600"
            >
              Project Type
            </label>
            <div class="relative">
              <select
                id="inquiry-project-type"
                name="projectType"
                required
                class="form-input appearance-none pr-8"
              >
                <option value="" disabled selected>
                  Select project type
                </option>
                {projectTypes.map((type) => (
                  <option value={type}>{type}</option>
                ))}
              </select>
              <svg
                class="text-ink pointer-events-none absolute top-1/2 right-1 h-4 w-4 -translate-y-1/2"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 9L12 15L18 9"></path>
              </svg>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="inquiry-budget" class="text-ui-label text-gray-600">
              Budget
            </label>
            <div class="relative">
              <select
                id="inquiry-budget"
                name="budget"
                required
                class="form-input appearance-none pr-8"
              >
                <option value="" disabled selected>
                  Select range
                </option>
                {budgetRanges.map((range) => (
                  <option value={range}>{range}</option>
                ))}
              </select>
              <svg
                class="text-ink pointer-events-none absolute top-1/2 right-1 h-4 w-4 -translate-y-1/2"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 9L12 15L18 9"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2.5">
          <label for="inquiry-message" class="text-ui-label text-gray-600">
            Message
          </label>
          <textarea
            id="inquiry-message"
            name="message"
            rows="4"
            required
            placeholder="What are you building, and what should it become?"
            class="focus-visible:outline-ink h-36 w-full scroll-mt-28 resize-y rounded-2xl border border-gray-600 bg-transparent p-4 text-base leading-relaxed font-normal tracking-[-0.01em] text-ink transition-colors placeholder:text-gray-600 focus:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 sm:text-lg"
          ></textarea>
        </div>

        <div class="pt-1">
          <button
            id="inquiry-submit-btn"
            type="submit"
            class="btn-primary w-full px-10 py-4 shadow-none"
          >
            {submitLabel}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "contact-inquiry-form",
  ) as HTMLFormElement | null;
  const submitBtn = document.getElementById(
    "inquiry-submit-btn",
  ) as HTMLButtonElement | null;

  if (form && submitBtn) {
    const defaultLabel = submitBtn.textContent?.trim() || "Send Inquiry";

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const requiredFields = form.querySelectorAll<
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >("[required]");

      for (const field of requiredFields) {
        if (!field.value.trim()) {
          field.focus();
          return;
        }
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";

      window.setTimeout(() => {
        form.reset();
        submitBtn.textContent = "Inquiry Sent";
        window.setTimeout(() => {
          submitBtn.disabled = false;
          submitBtn.textContent = defaultLabel;
        }, 2000);
      }, 400);
    });
  }
</script>
